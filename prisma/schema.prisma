generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model crm_Accounts {
  id                   String               @id @default(cuid())
  createdAt            DateTime?            @default(now()) @db.Date
  createdBy            String?
  updatedAt            DateTime?            @updatedAt @db.Date
  updatedBy            String?
  annual_revenue       String?
  assigned_to          String?
  billing_city         String?
  billing_country      String?
  billing_postal_code  String?
  billing_state        String?
  billing_street       String?
  company_id           String?
  description          String?
  email                String?
  employees            String?
  fax                  String?
  industry             String?
  member_of            String?
  name                 String
  office_phone         String?
  shipping_city        String?
  shipping_country     String?
  shipping_postal_code String?
  shipping_state       String?
  shipping_street      String?
  status               String?              @default("Inactive")
  type                 String?              @default("Customer")
  vat                  String?
  website              String?
  documentsIDs         String[]
  watchers             String[]
  invoices             Invoices[]
  assigned_to_user     Users?               @relation(fields: [assigned_to], references: [id])
  industry_type        crm_Industry_Type?   @relation(fields: [industry], references: [id])
  crm_accounts_tasks   crm_Accounts_Tasks[]
  contacts             crm_Contacts[]
  leads                crm_Leads[]
  opportunities        crm_Opportunities[]
  assigned_documents   Documents[]          @relation("DocumentsTocrm_Accounts")
  watching_users       Users[]              @relation("watching_accounts")
}

model crm_Leads {
  id                 String        @id @default(cuid())
  createdAt          DateTime?     @default(now()) @db.Date
  createdBy          String?
  updatedAt          DateTime?     @updatedAt @db.Date
  updatedBy          String?
  firstName          String?
  lastName           String
  company            String?
  jobTitle           String?
  email              String?
  phone              String?
  description        String?
  lead_source        String?
  refered_by         String?
  campaign           String?
  status             String?       @default("NEW")
  type               String?       @default("DEMO")
  assigned_to        String?
  accountsIDs        String?
  documentsIDs       String[]
  assigned_accounts  crm_Accounts? @relation(fields: [accountsIDs], references: [id])
  assigned_to_user   Users?        @relation(fields: [assigned_to], references: [id])
  assigned_documents Documents[]   @relation("DocumentsTocrm_Leads")
}

model crm_Opportunities {
  id                   String                          @id @default(cuid())
  account              String?
  assigned_to          String?
  budget               Int                             @default(0)
  campaign             String?
  close_date           DateTime?                       @db.Date
  contact              String?
  created_by           String?
  createdBy            String?
  created_on           DateTime?                       @default(now()) @db.Date
  createdAt            DateTime?                       @default(now()) @db.Date
  last_activity        DateTime?                       @db.Date
  updatedAt            DateTime?                       @updatedAt @db.Date
  updatedBy            String?
  last_activity_by     String?
  currency             String?
  description          String?
  expected_revenue     Int                             @default(0)
  name                 String?
  next_step            String?
  sales_stage          String?
  type                 String?
  status               crm_Opportunity_Status?         @default(ACTIVE)
  connected_documents  String[]
  connected_contacts   String[]
  assigned_account     crm_Accounts?                   @relation(fields: [account], references: [id])
  assigned_to_user     Users?                          @relation("assigned_to_user_relation", fields: [assigned_to], references: [id])
  assigned_campaings   crm_campaigns?                  @relation(fields: [campaign], references: [id])
  created_by_user      Users?                          @relation("created_by_user_relation", fields: [created_by], references: [id])
  assigned_sales_stage crm_Opportunities_Sales_Stages? @relation("assinged_sales_stage", fields: [sales_stage], references: [id])
  assigned_type        crm_Opportunities_Type?         @relation(fields: [type], references: [id])
  documents            Documents[]                     @relation("DocumentsTocrm_Opportunities")
  contacts             crm_Contacts[]                  @relation("crm_ContactsTocrm_Opportunities")
}

model crm_campaigns {
  id            String              @id @default(cuid())
  name          String
  description   String?
  status        String?
  opportunities crm_Opportunities[]
}

model crm_Opportunities_Sales_Stages {
  id                                 String              @id @default(cuid())
  name                               String
  probability                        Int?
  order                              Int?
  assigned_opportunities_sales_stage crm_Opportunities[] @relation("assinged_sales_stage")
}

model crm_Opportunities_Type {
  id                     String              @id @default(cuid())
  name                   String
  order                  Int?
  assigned_opportunities crm_Opportunities[]
}

model crm_Contacts {
  id                     String              @id @default(cuid())
  account                String?
  assigned_to            String?
  birthday               String?
  created_by             String?
  createdBy              String?
  created_on             DateTime?           @default(now())
  createdAt              DateTime?           @default(now()) @db.Date
  last_activity          DateTime?           @default(now()) @db.Date
  updatedAt              DateTime?           @updatedAt @db.Date
  updatedBy              String?
  last_activity_by       String?
  description            String?
  email                  String?
  personal_email         String?
  first_name             String?
  last_name              String
  office_phone           String?
  mobile_phone           String?
  website                String?
  position               String?
  status                 Boolean             @default(true)
  social_twitter         String?
  social_facebook        String?
  social_linkedin        String?
  social_skype           String?
  social_instagram       String?
  social_youtube         String?
  social_tiktok          String?
  type                   String?             @default("Customer")
  opportunitiesIDs       String[]
  accountsIDs            String?
  documentsIDs           String[]
  assigned_accounts      crm_Accounts?       @relation(fields: [accountsIDs], references: [id])
  assigned_to_user       Users?              @relation("assigned_contacts", fields: [assigned_to], references: [id])
  crate_by_user          Users?              @relation("created_contacts", fields: [created_by], references: [id])
  assigned_documents     Documents[]         @relation("DocumentsTocrm_Contacts")
  assigned_opportunities crm_Opportunities[] @relation("crm_ContactsTocrm_Opportunities")
}

model Boards {
  id                String    @id @default(cuid())
  description       String
  favourite         Boolean?
  favouritePosition Int?
  icon              String?
  position          Int?
  title             String
  user              String
  visibility        String?
  sharedWith        String[]
  createdAt         DateTime? @default(now()) @db.Date
  createdBy         String?
  updatedAt         DateTime? @updatedAt @db.Date
  updatedBy         String?
  watchers          String[]
  assigned_user     Users     @relation("assigned_user", fields: [user], references: [id])
  watchers_users    Users[]   @relation("watching_users")
}

model ImageUpload {
  id String @id @default(cuid())
}

model MyAccount {
  id                   String  @id @default(cuid())
  company_name         String
  is_person            Boolean @default(false)
  email                String?
  email_accountant     String?
  phone_prefix         String?
  phone                String?
  mobile_prefix        String?
  mobile               String?
  fax_prefix           String?
  fax                  String?
  website              String?
  street               String?
  city                 String?
  state                String?
  zip                  String?
  country              String?
  country_code         String?
  billing_street       String?
  billing_city         String?
  billing_state        String?
  billing_zip          String?
  billing_country      String?
  billing_country_code String?
  currency             String?
  currency_symbol      String?
  VAT_number           String
  TAX_number           String?
  bank_name            String?
  bank_account         String?
  bank_code            String?
  bank_IBAN            String?
  bank_SWIFT           String?
}

model Invoices {
  id                            String          @id @default(cuid())
  date_created                  DateTime        @default(now()) @db.Date
  last_updated                  DateTime        @updatedAt
  last_updated_by               String?
  date_received                 DateTime?       @default(now()) @db.Date
  date_of_case                  DateTime?       @db.Date
  date_tax                      DateTime?       @db.Date
  date_due                      DateTime?       @db.Date
  description                   String?
  document_type                 String?
  favorite                      Boolean?        @default(false)
  variable_symbol               String?
  constant_symbol               String?
  specific_symbol               String?
  order_number                  String?
  internal_number               String?
  invoice_number                String?
  invoice_amount                String?
  invoice_file_mimeType         String
  invoice_file_url              String
  invoice_items                 Json?
  invoice_type                  String?
  invoice_currency              String?
  invoice_language              String?
  partner                       String?
  partner_street                String?
  partner_city                  String?
  partner_zip                   String?
  partner_country               String?
  partner_country_code          String?
  partner_business_street       String?
  partner_business_city         String?
  partner_business_zip          String?
  partner_business_country      String?
  partner_business_country_code String?
  partner_VAT_number            String?
  partner_TAX_number            String?
  partner_TAX_local_number      String?
  partner_phone_prefix          String?
  partner_phone_number          String?
  partner_fax_prefix            String?
  partner_fax_number            String?
  partner_email                 String?
  partner_website               String?
  partner_is_person             Boolean?
  partner_bank                  String?
  partner_account_number        String?
  partner_account_bank_number   String?
  partner_IBAN                  String?
  partner_SWIFT                 String?
  partner_BIC                   String?
  rossum_status                 String?
  rossum_annotation_id          String?
  rossum_annotation_url         String?
  rossum_document_id            String?
  rossum_document_url           String?
  rossum_annotation_json_url    String?
  rossum_annotation_xml_url     String?
  money_s3_url                  String?
  status                        String?
  invoice_state_id              String?
  assigned_user_id              String?
  assigned_account_id           String?
  visibility                    Boolean         @default(true)
  connected_documents           String[]
  accounts                      crm_Accounts?   @relation(fields: [assigned_account_id], references: [id])
  users                         Users?          @relation(fields: [assigned_user_id], references: [id])
  invoice_states                invoice_States? @relation(fields: [invoice_state_id], references: [id])
  documents                     Documents[]     @relation("DocumentsToInvoices")
}

model invoice_States {
  id                String     @id @default(cuid())
  name              String
  assigned_invoices Invoices[]
}

model Documents {
  id                     String              @id @default(cuid())
  date_created           DateTime?           @default(now()) @db.Date
  createdAt              DateTime?           @default(now()) @db.Date
  last_updated           DateTime?           @updatedAt
  updatedAt              DateTime?           @updatedAt @db.Date
  document_name          String
  created_by_user        String?
  createdBy              String?
  description            String?
  document_type          String?
  favourite              Boolean?
  document_file_mimeType String
  document_file_url      String
  status                 String?
  visibility             String?
  tags                   Json?
  key                    String?
  size                   Int?
  assigned_user          String?
  connected_documents    String[]
  invoiceIDs             String[]
  opportunityIDs         String[]
  contactsIDs            String[]
  tasksIDs               String[]
  crm_accounts_tasksIDs  String?
  leadsIDs               String[]
  accountsIDs            String[]
  localFile              String
  employeeID             String
  document_system_type   DocumentSystemType? @default(OTHER)
  assigned_to_user       Users?              @relation("assigned_to_user", fields: [assigned_user], references: [id])
  created_by             Users?              @relation("created_by_user", fields: [created_by_user], references: [id])
  crm_accounts_tasks     crm_Accounts_Tasks? @relation(fields: [crm_accounts_tasksIDs], references: [id])
  documents_type         Documents_Types?    @relation(fields: [document_type], references: [id])
  employee               Employee            @relation(fields: [employeeID], references: [id])
  invoices               Invoices[]          @relation("DocumentsToInvoices")
  tasks                  Tasks[]             @relation("DocumentsToTasks")
  accounts               crm_Accounts[]      @relation("DocumentsTocrm_Accounts")
  contacts               crm_Contacts[]      @relation("DocumentsTocrm_Contacts")
  leads                  crm_Leads[]         @relation("DocumentsTocrm_Leads")
  opportunities          crm_Opportunities[] @relation("DocumentsTocrm_Opportunities")
}

model Documents_Types {
  id                 String      @id @default(cuid())
  name               String
  assigned_documents Documents[]
}

model Sections {
  id       String  @id @default(cuid())
  board    String
  title    String
  position Int?
  tasks    Tasks[]
}

model crm_Industry_Type {
  id       String         @id @default(cuid())
  name     String
  accounts crm_Accounts[]
}

model modulStatus {
  id        String  @id @default(cuid())
  name      String
  isVisible Boolean
}

model Tasks {
  id               String          @id @default(cuid())
  content          String?
  createdAt        DateTime?       @default(now()) @db.Date
  createdBy        String?
  updatedAt        DateTime?       @updatedAt @db.Date
  updatedBy        String?
  dueDateAt        DateTime?       @default(now()) @db.Date
  lastEditedAt     DateTime?       @default(now()) @updatedAt @db.Date
  position         Int
  priority         String
  section          String?
  tags             Json?
  title            String
  likes            Int?            @default(0)
  user             String?
  documentIDs      String[]
  taskStatus       taskStatus?     @default(ACTIVE)
  assigned_section Sections?       @relation(fields: [section], references: [id])
  assigned_user    Users?          @relation(fields: [user], references: [id])
  comments         tasksComments[]
  documents        Documents[]     @relation("DocumentsToTasks")
}

model crm_Accounts_Tasks {
  id            String          @id @default(cuid())
  content       String?
  createdAt     DateTime?       @default(now()) @db.Date
  createdBy     String?
  updatedAt     DateTime?       @updatedAt @db.Date
  updatedBy     String?
  dueDateAt     DateTime?       @default(now()) @db.Date
  priority      String
  tags          Json?
  title         String
  likes         Int?            @default(0)
  user          String?
  account       String?
  taskStatus    taskStatus?     @default(ACTIVE)
  documents     Documents[]
  crm_accounts  crm_Accounts?   @relation(fields: [account], references: [id])
  assigned_user Users?          @relation(fields: [user], references: [id])
  comments      tasksComments[]
}

model tasksComments {
  id                             String              @id @default(cuid())
  comment                        String
  createdAt                      DateTime            @default(now()) @db.Date
  task                           String
  user                           String
  employeeID                     String
  assigned_crm_account_task      String?
  assigned_crm_account_task_task crm_Accounts_Tasks? @relation(fields: [assigned_crm_account_task], references: [id])
  employee                       Employee            @relation(fields: [employeeID], references: [id])
  assigned_task                  Tasks               @relation(fields: [task], references: [id], onDelete: Cascade)
  assigned_user                  Users               @relation(fields: [user], references: [id])
  teamTasks                      TeamTask[]          @relation("TeamTaskTotasksComments")
}

model TodoList {
  id          String @id @default(cuid())
  createdAt   String
  description String
  title       String
  url         String
  user        String
}

model Users {
  id                   String                @id @default(cuid())
  account_name         String?
  avatar               String?
  email                String                @unique
  is_account_admin     Boolean               @default(false)
  is_admin             Boolean               @default(false)
  created_on           DateTime              @default(now()) @db.Date
  lastLoginAt          DateTime?             @db.Date
  name                 String?
  password             String?
  username             String?
  userStatus           ActiveStatus          @default(PENDING)
  userLanguage         Language              @default(en)
  watching_boardsIDs   String[]
  watching_accountsIDs String[]
  role                 Role                  @default(guest)
  boards               Boards[]              @relation("assigned_user")
  userWorkflowDef      Definitions[]
  assigned_documents   Documents[]           @relation("assigned_to_user")
  created_by_documents Documents[]           @relation("created_by_user")
  employee             Employee[]
  assigned_invoices    Invoices[]
  tasks                Tasks[]
  accounts             crm_Accounts[]
  crm_accounts_tasks   crm_Accounts_Tasks[]
  assigned_contacts    crm_Contacts[]        @relation("assigned_contacts")
  created_contacts     crm_Contacts[]        @relation("created_contacts")
  leads                crm_Leads[]
  assigned_opportunity crm_Opportunities[]   @relation("assigned_to_user_relation")
  created_by_user      crm_Opportunities[]   @relation("created_by_user_relation")
  openAi_key           openAi_keys[]
  notion_account       secondBrain_notions[]
  tasksComment         tasksComments[]
  watching_accounts    crm_Accounts[]        @relation("watching_accounts")
  watching_boards      Boards[]              @relation("watching_users")
}

model system_Modules_Enabled {
  id       String  @id @default(cuid())
  name     String
  enabled  Boolean
  position Int
}

model secondBrain_notions {
  id             String @id @default(cuid())
  user           String
  notion_api_key String
  notion_db_id   String
  assigned_user  Users  @relation(fields: [user], references: [id])
}

model openAi_keys {
  id              String @id @default(cuid())
  user            String
  organization_id String
  api_key         String
  assigned_user   Users  @relation(fields: [user], references: [id])
}

model systemServices {
  id              String  @id @default(cuid())
  name            String
  serviceUrl      String?
  serviceId       String?
  serviceKey      String?
  servicePassword String?
  servicePort     String?
  description     String?
}

model gpt_models {
  id          String     @id @default(cuid())
  model       String
  description String?
  status      gptStatus?
  created_on  DateTime?  @default(now()) @db.Date
}

model Employee {
  id               String          @id @default(uuid())
  createdBy        String?
  updatedBy        String?
  firstName        String
  lastName         String
  email            String          @unique
  phone            String          @unique
  role             CompanyRole     @default(Employee)
  position         String?
  salary           Float           @default(0.00)
  onBoarding       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  IBAN             String
  photo            String?
  taxid            String?
  address          String?
  insurance        String?
  assigned_to      String?
  teamsId          String?
  Documents        Documents[]
  assigned_to_user Users?          @relation(fields: [assigned_to], references: [id])
  Teams            Teams?          @relation(fields: [teamsId], references: [id])
  sent             Message[]       @relation("sender")
  from             Message[]       @relation("receiver")
  PaySlip          PaySlip[]
  PaySlipData      PaySlipData[]
  Request          Request[]
  Schedule         Schedule[]
  TeamMessage      TeamMessage[]   @relation("sender")
  timekeeping      Timekeeping[]
  Training         Training[]
  Comments         tasksComments[]
}

model Teams {
  id          String        @id @default(uuid())
  name        String
  tasks       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     Employee[]
  TeamMessage TeamMessage[] @relation("receiver")
  TeamTask    TeamTask[]
}

model Timekeeping {
  id         String    @id @default(uuid())
  employeeID String
  timeIn     DateTime
  timeOut    DateTime?
  verified   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeID], references: [id])
}

model TeamTask {
  id           String          @id @default(uuid())
  teamID       String
  task         String
  description  String?
  done         Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deadline     DateTime
  team         Teams           @relation(fields: [teamID], references: [id], onDelete: Cascade)
  TaskComments tasksComments[] @relation("TeamTaskTotasksComments")
}

model Schedule {
  id         String   @id @default(uuid())
  employeeID String
  date       DateTime
  timeIn     DateTime
  timeOut    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeID], references: [id])
}

model Training {
  id         String   @id @default(uuid())
  employeeID String
  type       String
  date       DateTime
  time       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  localFile  String
  employee   Employee @relation(fields: [employeeID], references: [id])
}

model PaySlip {
  id         String   @id @default(uuid())
  employeeID String
  month      DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  localFile  String
  employee   Employee @relation(fields: [employeeID], references: [id])
}

model PaySlipData {
  id         String   @id @default(uuid())
  employeeID String
  hours      Float
  rate       Float
  deduction  Float
  IBAN       String
  month      DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeID], references: [id])
}

model Request {
  id         String      @id @default(uuid())
  employeeID String
  type       RequestType
  approved   Boolean     @default(false)
  message    String
  date       DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  employee   Employee    @relation(fields: [employeeID], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  fromID    String
  toID      String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from      Employee @relation("sender", fields: [fromID], references: [id])
  to        Employee @relation("receiver", fields: [toID], references: [id])
}

model TeamMessage {
  id        String   @id @default(uuid())
  fromID    String
  toID      String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from      Employee @relation("sender", fields: [fromID], references: [id])
  to        Teams    @relation("receiver", fields: [toID], references: [id])
}

model Definitions {
  id                 String           @id @default(cuid())
  name               String
  description        String
  tasks              Json[]
  global             Json?
  definitionStatus   DefinitionStatus @default(active)
  uiObject           Json?
  createdAt          DateTime?        @default(now()) @db.Date
  updatedAt          DateTime?        @updatedAt @db.Date
  userWfDefinitionId String
  userWfDefinition   Users            @relation(fields: [userWfDefinitionId], references: [id])
  runtimes           Runtimes[]
}

model Runtimes {
  id                   String        @id @default(cuid())
  workflowResults      Json?
  global               Json?
  tasks                Json[]
  logs                 Json[]
  workflowStatus       RuntimeStatus @default(pending)
  workflowDefinitionId String
  createdAt            DateTime?     @default(now()) @db.Date
  updatedAt            DateTime?     @updatedAt @db.Date
  definitions          Definitions   @relation(fields: [workflowDefinitionId], references: [id])
}

enum crm_Lead_Status {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

enum crm_Lead_Type {
  DEMO
}

enum crm_Opportunity_Status {
  ACTIVE
  INACTIVE
  PENDING
  CLOSED
}

enum crm_Contact_Type {
  Customer
  Partner
  Vendor
}

enum DocumentSystemType {
  INVOICE
  RECEIPT
  CONTRACT
  OFFER
  ID
  PASSPORT
  VISA
  INSURANCE
  HEALTH
  CERTIFICATE
  OTHER
}

enum taskStatus {
  ACTIVE
  PENDING
  COMPLETE
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum Language {
  cz
  de
  en
  uk
  ko
  tr
}

enum gptStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  admin
  user
  guest
}

enum CompanyRole {
  Admin
  Employee
  Manager
}

enum Document {
  ID
  Passport
  Visa
  Insurance
  Health
  Contract
  Certificate
  Other
}

enum RequestType {
  Documents
  Vacation
  Leave
  Training
  Raise
  Department
  Other
  Sick
}

enum DefinitionStatus {
  active
  inactive
}

enum RuntimeStatus {
  pending
  completed
  failed
}
